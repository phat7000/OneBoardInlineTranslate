<Window x:Class="OneBoardInlineTranslate.Views.ReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneBoard Reply Mode" Icon="/Assets/OneBoardInlineTranslate.ico"
        Width="650" Height="650" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock FontSize="21" FontWeight="SemiBold" Text="Reply Mode" />
      <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                 Text="Review first. Insert never sends." />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardStyle}">
      <StackPanel>
        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="ORIGINAL" />
        <TextBlock x:Name="OriginalText" Margin="0,6,0,0" MaxHeight="90" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="0,0,0,0" Style="{StaticResource CardStyle}" Background="#F8FAFC">
      <StackPanel>
        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="UNDERSTANDING" />
        <TextBlock x:Name="UnderstandingText" Margin="0,6,0,0" MaxHeight="100" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,18,0,7">
      <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Reply in your preferred language" />
      <ComboBox x:Name="TargetLanguageCombo" DockPanel.Dock="Right" Width="230" IsEditable="True"
                IsTextSearchEnabled="False" DisplayMemberPath="PickerLabel" SelectedValuePath="Code"
                KeyUp="TargetLanguageCombo_KeyUp" DropDownOpened="TargetLanguageCombo_DropDownOpened"
                AutomationProperties.Name="Reply target language" />
    </DockPanel>

    <Grid Grid.Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBox x:Name="ReplyInput" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" MinHeight="90"
               AutomationProperties.Name="Reply in preferred language" />
      <TextBox x:Name="TranslatedReply" Grid.Row="1" Margin="0,10,0,0" AcceptsReturn="True"
               IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               MinHeight="90" AutomationProperties.Name="Translated reply preview" />
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,10,0,0"
               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

    <StackPanel Grid.Row="6" Margin="-4,12,-4,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button Content="Copy" Click="Copy_Click" />
      <Button Content="Translate Reply" Click="Translate_Click" />
      <Button Content="Insert" Click="Insert_Click" Background="{StaticResource AccentBrush}"
              Foreground="White" BorderBrush="{StaticResource AccentBrush}" />
    </StackPanel>
  </Grid>
</Window>
