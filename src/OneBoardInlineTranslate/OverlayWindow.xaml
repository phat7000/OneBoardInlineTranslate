<Window x:Class="OneBoardInlineTranslate.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneBoard Inline Translate"
        Icon="/Assets/OneBoardInlineTranslate.ico"
        Width="460" Height="300" MinWidth="320" MinHeight="150" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True">
  <Border x:Name="Surface" Margin="10" Padding="14" CornerRadius="12" Background="#FCFFFFFF">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16" Color="#334155" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="Header" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#E8F0FE" CornerRadius="8" Padding="7,3">
            <TextBlock x:Name="LanguageRouteText" Foreground="#1D4ED8" FontSize="11"
                       FontWeight="SemiBold" Text="TRANSLATION" />
          </Border>
          <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center"
                     Foreground="#64748B" FontSize="11" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="UnpinButton" Width="29" Height="27" MinHeight="0" Padding="0" Margin="0,0,3,0"
                  Content="↙" FontSize="13" ToolTip="Switch to popup mode"
                  AutomationProperties.Name="Unpin result window" Click="Unpin_Click" />
          <Button Width="29" Height="27" MinHeight="0" Padding="0" Margin="0"
                  Content="×" FontSize="16" ToolTip="Close" AutomationProperties.Name="Close translation"
                  Click="Close_Click" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="SourceLanguageText" Grid.Row="1" Margin="1,11,0,4"
                 Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" />
      <ScrollViewer Grid.Row="2" MaxHeight="170" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="OriginalText" Foreground="#475569" FontSize="12.5" LineHeight="19"
                   TextWrapping="Wrap" />
      </ScrollViewer>

      <TextBlock x:Name="TargetLanguageText" Grid.Row="3" Margin="1,11,0,4"
                 Foreground="#2563EB" FontSize="10" FontWeight="SemiBold" />
      <ScrollViewer Grid.Row="4" MaxHeight="280" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="TranslatedText" Foreground="#172033" FontSize="15" LineHeight="22"
                   TextWrapping="Wrap" />
      </ScrollViewer>

      <DockPanel Grid.Row="5" Margin="0,12,0,0">
        <TextBlock x:Name="MetadataText" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="10" />
        <Button DockPanel.Dock="Right" Content="Copy" Margin="6,0,0,0" Height="29" MinHeight="0"
                Padding="11,3" AutomationProperties.Name="Copy translation" Click="Copy_Click" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
