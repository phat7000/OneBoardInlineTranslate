<Window x:Class="OneBoardInlineTranslate.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneBoard Inline Translate"
        Width="480" MinHeight="150" MaxHeight="520"
        SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Focusable="False" Topmost="True">
  <Border Margin="10" Padding="18" CornerRadius="14" Background="#FAFFFFFF"
          BorderBrush="#DCE3EC" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.20" Color="#334155" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" Text="TRANSLATION" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Width="30" Height="28" MinHeight="0" Padding="0" Margin="0"
                Content="×" FontSize="17" ToolTip="Close" AutomationProperties.Name="Close translation"
                Click="Close_Click" />
      </DockPanel>

      <TextBlock x:Name="SourceLanguageText" Grid.Row="1" Margin="0,12,0,5"
                 Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Text="SOURCE" />
      <ScrollViewer Grid.Row="2" MaxHeight="130" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="OriginalText" Foreground="#475569" FontSize="13" TextWrapping="Wrap" />
      </ScrollViewer>

      <Border Grid.Row="3" Margin="0,13,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
        <TextBlock x:Name="TargetLanguageText" Margin="0,12,0,5" Foreground="#2563EB"
                   FontSize="11" FontWeight="SemiBold" Text="TRANSLATION" />
      </Border>
      <ScrollViewer Grid.Row="4" MaxHeight="190" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="TranslatedText" Foreground="#172033" FontSize="15" LineHeight="22"
                   TextWrapping="Wrap" />
      </ScrollViewer>

      <DockPanel Grid.Row="5" Margin="0,15,0,0">
        <TextBlock x:Name="MetadataText" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="10" />
        <Button DockPanel.Dock="Right" Content="Copy translation" Margin="8,0,0,0"
                AutomationProperties.Name="Copy translation" Click="Copy_Click" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
